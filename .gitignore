# Ignore everything in tf/ by default; opt in to cfg/ and custom/
*
!.gitignore
!.gitattributes
!README.md
!cfg/
!cfg/**
!custom/
!custom/**

# ---- generated by the game / Steam ----
*.cache
# config.cfg is rewritten on every exit and stores the last server password;
# anything worth keeping is pinned in cfg/overrides/autoexec.cfg instead.
cfg/config.cfg
cfg/user.scr
cfg/motd_entries.txt
cfg/server_blacklist.txt
cfg/banned_ip.cfg
cfg/banned_user.cfg
cfg/sixense_bindings.cfg
cfg/unencrypted/

# ---- Valve stock files (installed/updated by Steam) ----
cfg/360controller*.cfg
cfg/undo360controller.cfg
cfg/chapter*.cfg
cfg/config_default.cfg
cfg/mapcycle_*.txt
cfg/motd_default.txt
cfg/motd_text_default.txt
cfg/mtp.cfg
cfg/pure_server_*.txt
cfg/replay_example.cfg
cfg/server_*.cfg
cfg/sfm_defaultanimationgroups.txt
cfg/sourcevr_tf.cfg
cfg/trusted_keys_*.txt
cfg/vscript_convar_allowlist.txt
custom/readme.txt
custom/workshop/

# ---- backups / editor junk ----
*.bak
*.bak[0-9]
*~

# ---- big, generated, or versioned elsewhere ----
# symlink to ~/Projects/demo2nut/runtime (own repo); no trailing slash, it's a symlink
custom/demo2nut
# clip scripts generated by demo2nut (~500 MB)
custom/demo2nut_clips/
custom/myscripts/scripts/vscripts/replay_data.nut
# Generated Linux HUD fonts (renamed MS core fonts, not redistributable).
# Rebuild with: python3 "custom/eve hud/resource/fonts/make_linux_fonts.py"
custom/eve hud/resource/fonts/*.ttf
